{
  "name": "caidao-jianghu",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm content:validate && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "content:validate": "node --experimental-strip-types --loader ./scripts/content-ts-loader.mjs ./scripts/content-validate.ts",
    "simulate:battles": "node --experimental-strip-types --loader ./scripts/content-ts-loader.mjs ./scripts/simulate-battles.ts",
    "report:progression": "node --experimental-strip-types --loader ./scripts/content-ts-loader.mjs ./scripts/report-progression.ts",
    "playtest:timer": "node ./scripts/record-playtest.mjs",
    "assets:audit": "node ./scripts/audit-assets.mjs",
    "release:package": "node ./scripts/package-release.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.3",
    "vitest": "^3.1.2"
  }
}
